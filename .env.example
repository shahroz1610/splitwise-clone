# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key (or a "secret" sb_secret_... key). Server-only — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode required to add/edit/delete anything. Leave empty to let anyone with the link edit.
GROUP_PASSCODE=
