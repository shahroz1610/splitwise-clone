# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon (or "publishable" sb_publishable_...) key — used server-side only, for Google sign-in sessions.
SUPABASE_ANON_KEY=
# The service_role (or "secret" sb_secret_...) key. Server-only — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required. New people enter this once, after their first Google sign-in, to join the group.
GROUP_PASSCODE=
